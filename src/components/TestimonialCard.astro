---
interface Props {
  quote: string;
  author: string;
  date: string;
}

const { quote, author, date } = Astro.props;
---

<figure class="testimonial-card">
  <blockquote>&laquo;{quote}&raquo;</blockquote>
  <figcaption>
    <span class="author">{author}</span>
    <span class="date">{date}</span>
  </figcaption>
</figure>

<style>
  .testimonial-card {
    background: var(--color-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-ink);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    border-top: 1px solid var(--color-stone);
    padding-top: 0.75rem;
  }

  .author {
    font-weight: 700;
    color: var(--color-wine);
  }
</style>
