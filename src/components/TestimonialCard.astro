---
import StarRating from './StarRating.astro';

interface Props {
  quote: string;
  author: string;
  date: string;
}

const { quote, author, date } = Astro.props;
---

<figure class="testimonial-card">
  <StarRating />
  <blockquote>{quote}</blockquote>
  <figcaption>
    <span class="author">{author}</span>
    <span class="date">{date}</span>
  </figcaption>
</figure>

<style>
  .testimonial-card {
    margin: 0;
    padding: 2rem 1.9rem 1.6rem;
    background: color-mix(in srgb, var(--color-white) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bronze-on-dark) 28%, transparent);
    border-top: 2px solid var(--color-bronze-on-dark);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
  }

  /* הכרטיס הוא flex עם gap של 1.25rem — רווח נכון בין ציטוט לחתימה, אבל
     גדול מדי בין הכוכבים לציטוט שהם מדרגים. מקזזים אותו חלקית.
     `:global` כי `.stars` נולד ב-StarRating ולכן נושא את ה-scope שלו. */
  .testimonial-card :global(.stars) {
    color: var(--color-bronze-on-dark);
    margin-block-end: -0.65rem;
  }

  blockquote {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 300;
    color: var(--color-on-dark);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-block-start: auto;
    padding-block-start: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--color-bronze-on-dark) 25%, transparent);
  }

  .author {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-on-dark);
  }

  .date {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-bronze-on-dark);
  }
</style>
