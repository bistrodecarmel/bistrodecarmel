---
interface Props {
  quote: string;
  author: string;
  date: string;
}

const { quote, author, date } = Astro.props;
---

<figure class="testimonial-card">
  <span class="quote-mark" aria-hidden="true">&rdquo;</span>
  <blockquote>{quote}</blockquote>
  <figcaption>
    <span class="author">{author}</span>
    <span class="date">{date}</span>
  </figcaption>
</figure>

<style>
  .testimonial-card {
    position: relative;
    margin: 0;
    padding: 2.2rem 2rem 1.8rem;
    background: color-mix(in srgb, var(--color-olive) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bronze) 35%, transparent);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    height: 100%;
  }

  .quote-mark {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-start: 1.2rem;
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-bronze);
    opacity: 0.55;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-ivory);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.82rem;
    color: var(--color-bronze-soft);
    border-top: 1px solid color-mix(in srgb, var(--color-bronze) 30%, transparent);
    padding-top: 0.85rem;
    margin-block-start: auto;
  }

  .author {
    font-weight: 700;
    color: var(--color-white);
  }
</style>
