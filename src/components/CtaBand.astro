---
import LeadForm from './LeadForm.astro';

interface Props {
  heading?: string;
  headingStrong?: string;
  sub?: string;
  instanceId: string;
}

const {
  heading = 'חוגגים',
  headingStrong = 'בקרוב?',
  sub = 'השאירו פרטים ונחזור אליכם מיד עם כל הפרטים על אירוע מושלם אצלנו',
  instanceId,
} = Astro.props;
---

<section class="cta-band" id="contact">
  <img class="cta-corner" src="/images/decor/corner-olive.webp" alt="" aria-hidden="true" loading="lazy" />
  <div class="container cta-grid">
    <div class="cta-text" data-animate="fade-up">
      <p class="eyebrow">צור קשר</p>
      <h2 class="cta-title">{heading} <strong>{headingStrong}</strong></h2>
      <p class="lead">{sub}</p>

      <a class="cta-phone" href="tel:+972554316261">
        <span class="cta-phone-label">או חייגו עכשיו</span>
        <span class="cta-phone-number" dir="ltr">055-4316261</span>
      </a>

      <ul class="cta-facts">
        <li>אירועים מ-70 עד 250 מוזמנים</li>
        <li>רחוב היין 20, זכרון יעקב</li>
        <li>מטבח שף כשר ובשרי</li>
      </ul>

      <img
        class="cta-engraving"
        src="/images/decor/engraving-wine.webp"
        alt=""
        aria-hidden="true"
        loading="lazy"
      />
    </div>

    <div class="cta-form" data-animate="fade-up">
      <LeadForm heading="השאירו פרטים ונחזור אליכם מיד" instanceId={instanceId} />
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section-pad);
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-ivory) 82%, transparent),
        color-mix(in srgb, var(--color-ivory) 82%, transparent)
      ),
      var(--texture-stone) center / cover;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .cta-text {
    max-width: 520px;
  }

  /* כותרת גדולה ודומיננטית */
  .cta-title {
    font-size: clamp(2.6rem, 4.5vw + 1rem, 4.6rem);
    margin-block-end: 0.35em;
  }

  .cta-phone {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-block: 1.5rem 1.75rem;
    text-decoration: none;
    border-inline-start: 3px solid var(--color-bronze-line);
    padding-inline-start: 1.1rem;
  }

  .cta-phone-label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-bronze-text);
  }

  .cta-phone-number {
    font-size: clamp(1.9rem, 2.5vw, 2.6rem);
    font-weight: 200;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    line-height: 1.15;
    transition: color 0.2s ease;
    text-align: start;
  }

  .cta-phone:hover .cta-phone-number {
    color: var(--color-bronze-text);
  }

  .cta-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .cta-facts li {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .cta-facts li::before {
    content: '✦';
    font-size: 0.6rem;
    color: var(--color-bronze-line);
    flex-shrink: 0;
  }

  /* PNG שקוף — בלי blend-mode, כדי שלא ייראה "ריבוע" סביב האיור */
  .cta-engraving {
    margin-block-start: 2rem;
    max-width: 190px;
    opacity: 0.8;
  }

  .cta-band {
    position: relative;
    overflow: hidden;
  }

  /* עיטור פינתי — עלי זית בקו ברונזה */
  .cta-corner {
    position: absolute;
    inset-block-end: -40px;
    inset-inline-start: -40px;
    width: clamp(180px, 22vw, 320px);
    opacity: 0.55;
    pointer-events: none;
  }

  /* כרטיס הטופס מקבל נוכחות */
  .cta-form :global(.lead-form) {
    border-top: 3px solid var(--color-bronze-line);
    box-shadow: var(--shadow-soft);
    max-width: 460px;
    margin-inline-start: auto;
  }

  @media (max-width: 900px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .cta-engraving,
    .cta-corner {
      display: none;
    }

    .cta-form :global(.lead-form) {
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
