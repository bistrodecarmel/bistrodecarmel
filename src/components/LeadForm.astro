---
interface Props {
  heading?: string;
  compact?: boolean;
  instanceId?: string;
}

const { heading = 'השאירו פרטים ונחזור אליכם מיד', compact = false, instanceId = 'default' } = Astro.props;
const idFor = (field: string) => `lead-${instanceId}-${field}`;
---

<form
  name="lead"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class:list={['lead-form', { compact }]}
  action="/thank-you-page/"
>
  <input type="hidden" name="form-name" value="lead" />
  <p class="hidden-field">
    <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
  </p>

  {heading && <h3>{heading}</h3>}
  <p class="min-guests-note">שימו לב – אנו מקיימים אירועים החל מ-70 מוזמנים בלבד.</p>

  <div class="field">
    <label for={idFor('name')}>שם</label>
    <input id={idFor('name')} name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for={idFor('phone')}>נייד</label>
    <input id={idFor('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
  </div>

  <div class="field">
    <label for={idFor('guests')}>כמות מוזמנים <span class="hint">(החל מ-70)</span></label>
    <input id={idFor('guests')} name="guests" type="number" min="70" inputmode="numeric" />
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>
      הינני מסכימ/ה לתקנון האתר, <a href="/מדיניות-פרטיות-ביסטרו-דה-כרמל/">תנאי השימוש ומדיניות הפרטיות</a>
      של האתר.
    </span>
  </label>

  <button type="submit" class="btn btn-primary">שליחה &laquo;</button>
  <p class="phone-alt">או חייגו <a href="tel:+972554316261">055-4316261</a></p>
</form>

<style>
  .lead-form {
    background: var(--color-white);
    border: 1px solid var(--color-ivory-deep);
    border-radius: var(--radius-lg);
    padding: 2rem 1.9rem;
    box-shadow: var(--shadow-card);
    max-width: 430px;
  }

  .lead-form h3 {
    margin-block-end: 0.35rem;
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .min-guests-note {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-muted);
    margin-block-end: 1.4rem;
  }

  .field {
    margin-block-end: 1.05rem;
  }

  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-block-end: 0.35rem;
  }

  .hint {
    font-weight: 500;
    color: var(--color-muted);
  }

  .field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-ivory-deep);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field input:focus {
    outline: none;
    border-color: var(--color-bronze-text);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-bronze-line) 25%, transparent);
  }

  .consent {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin-block-end: 1.25rem;
  }

  .consent input {
    margin-block-start: 0.2rem;
    accent-color: var(--color-olive);
  }

  .consent a {
    color: var(--color-bronze-text);
  }

  .lead-form .btn {
    width: 100%;
  }

  .phone-alt {
    text-align: center;
    margin-block: 0.9rem 0;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .phone-alt a {
    font-weight: 700;
    color: var(--color-bronze-text);
    text-decoration: none;
  }

  .phone-alt a:hover {
    text-decoration: underline;
  }

  .hidden-field {
    display: none;
  }
</style>
