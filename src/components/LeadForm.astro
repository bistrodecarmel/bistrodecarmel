---
interface Props {
  heading?: string;
  compact?: boolean;
  instanceId?: string;
}

const { heading = 'השאירו פרטים ונחזור אליכם מיד', compact = false, instanceId = 'default' } = Astro.props;
const idFor = (field: string) => `lead-${instanceId}-${field}`;
---

<form
  name="lead"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class:list={['lead-form', { compact }]}
  action="/thank-you-page/"
>
  <input type="hidden" name="form-name" value="lead" />
  <p class="hidden-field">
    <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
  </p>

  {heading && <h3>{heading}</h3>}
  <p class="min-guests-note">שימו לב – אנו מקיימים אירועים החל מ-70 מוזמנים בלבד.</p>

  <div class="field">
    <label for={idFor('name')}>שם</label>
    <input id={idFor('name')} name="name" type="text" required />
  </div>

  <div class="field">
    <label for={idFor('phone')}>נייד</label>
    <input id={idFor('phone')} name="phone" type="tel" required />
  </div>

  <div class="field">
    <label for={idFor('guests')}>כמות מוזמנים (החל מ-70 בלבד)</label>
    <input id={idFor('guests')} name="guests" type="number" min="70" />
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    הינני מסכימ/ה לתקנון האתר, <a href="/מדיניות-פרטיות-ביסטרו-דה-כרמל/">תנאי השימוש ומדיניות הפרטיות</a> של
    האתר.
  </label>

  <button type="submit" class="btn btn-primary">שליחה &raquo;</button>
  <p class="phone-alt">או חייגו <a href="tel:+972554316261">055-4316261</a></p>
</form>

<style>
  .lead-form {
    background: var(--color-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
    max-width: 420px;
  }

  .lead-form h3 {
    margin-block-end: 0.35rem;
  }

  .min-guests-note {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .field {
    margin-block-end: 0.9rem;
  }

  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-block-end: 0.3rem;
  }

  .field input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .consent {
    display: block;
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    margin-block-end: 1rem;
  }

  .consent input {
    inline-size: auto;
    margin-inline-end: 0.4rem;
  }

  .lead-form .btn {
    width: 100%;
  }

  .phone-alt {
    text-align: center;
    margin-block: 0.75rem 0;
    font-size: 0.9rem;
  }

  .hidden-field {
    display: none;
  }
</style>
