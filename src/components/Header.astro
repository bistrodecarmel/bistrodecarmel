---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  /** שקוף מעל הירו (דף הבית) או מלא מההתחלה (עמודים פנימיים) */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const navLinks = [
  { href: '/weddings-bistro-de-carmel/', label: 'חתונות בביסטרו' },
  { href: '/בת-מצווה-בביסטרו-דה-כרמל/', label: 'בת מצווה' },
  { href: '/בר-מצווה-בביסטרו-דה-כרמל/', label: 'בר מצווה' },
  { href: '/חוגגים-עלייה-לתורה-ובר-מצווה-בזכרון-יע/', label: 'הפקת עליה לתורה' },
  { href: '/המלצות/', label: 'המלצות' },
  { href: '/#food', label: 'קולינריה' },
  { href: '/#gallery', label: 'גלריה' },
  { href: '/#contact', label: 'צור קשר' },
];
---

<header class:list={['site-header', { overlay }]} id="site-header">
  <div class="container-wide header-inner">
    <a href="/" class="logo-link" aria-label="ביסטרו דה כרמל - חזרה לדף הבית">
      <Image src={logo} alt="ביסטרו דה כרמל" width={150} height={49} />
    </a>

    <nav class="main-nav" aria-label="תפריט ראשי">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="tel:+972554316261" class="phone-cta">055-4316261</a>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="פתיחת תפריט"
      id="menu-toggle"
    >
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="תפריט נייד" hidden>
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li class="mobile-phone"><a href="tel:+972554316261">055-4316261</a></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header?.classList.contains('overlay')) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 40);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.classList.toggle('open', !isOpen);
    if (mobileNav) mobileNav.hidden = isOpen;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-ivory-deep);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header.overlay {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header.overlay:not(.scrolled) .main-nav a {
    color: var(--color-white);
  }

  .site-header.overlay:not(.scrolled) .phone-cta {
    color: var(--color-white);
    border-color: color-mix(in srgb, var(--color-white) 55%, transparent);
  }

  .site-header.overlay:not(.scrolled) .phone-cta:hover {
    background: color-mix(in srgb, var(--color-white) 14%, transparent);
    border-color: var(--color-white);
  }

  .site-header.overlay:not(.scrolled) .logo-link img {
    filter: brightness(0) invert(0.97);
  }

  .site-header.overlay:not(.scrolled) .menu-toggle span {
    background: var(--color-white);
  }

  .site-header.overlay.scrolled {
    background: color-mix(in srgb, var(--color-cream) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-ivory-deep);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-block: 0.8rem;
  }

  .logo-link {
    flex-shrink: 0;
    display: block;
  }

  .logo-link img {
    transition: filter 0.3s ease;
  }

  .main-nav {
    flex: 1;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .main-nav a {
    position: relative;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-ink);
    padding-block: 0.35rem;
    transition: color 0.2s ease;
  }

  .main-nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--color-bronze-line);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.25s ease;
  }

  .main-nav a:hover::after {
    transform: scaleX(1);
  }

  .phone-cta {
    flex-shrink: 0;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    text-decoration: none;
    border: 1px solid var(--color-ivory-deep);
    border-radius: var(--radius-sm);
    padding: 0.5rem 1.1rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .phone-cta:hover {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: var(--color-white);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    padding: 0.6rem 0.4rem;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-ink);
    transition:
      transform 0.3s ease,
      background 0.3s ease;
  }

  .menu-toggle.open span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle.open span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-nav {
    background: var(--color-cream);
    border-top: 1px solid var(--color-ivory-deep);
    padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .mobile-phone {
    margin-block-start: 0.5rem;
    padding-block-start: 1rem;
    border-top: 1px solid var(--color-ivory-deep);
  }

  .mobile-phone a {
    color: var(--color-bronze-text);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 960px) {
    .main-nav,
    .phone-cta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
