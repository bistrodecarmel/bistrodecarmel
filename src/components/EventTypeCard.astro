---
import Img from './Img.astro';

interface Props {
  title: string;
  href: string;
  image: string;
  index: number;
}

const { title, href, image, index } = Astro.props;
const num = String(index).padStart(2, '0');
---

<a class="event-card" href={href}>
  <div class="frame">
    {/* 4 עמודות בדסקטופ (~280px), 2 בטאבלט, עמודה מלאה במובייל */}
    <Img
      src={image}
      alt={title}
      sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 24vw"
      widths={[320, 480, 640]}
      loading="lazy"
    />
  </div>
  <div class="meta">
    <span class="num" aria-hidden="true">{num}</span>
    <div class="meta-text">
      <h3>{title}</h3>
      <span class="cta">לפרטים נוספים <span class="arrow" aria-hidden="true">←</span></span>
    </div>
  </div>
</a>

<style>
  .event-card {
    display: block;
    text-decoration: none;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    /* מוטיב הקשת — מהדהד את קשתות האבן של המבנה */
    border-radius: 999px 999px var(--radius-md) var(--radius-md);
    background: var(--color-ivory);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(34, 39, 30, 0.28), transparent 40%);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .event-card:hover .frame img {
    transform: scale(1.055);
  }

  .meta {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding-block-start: 1.15rem;
  }

  .num {
    font-weight: 250;
    font-size: 1.7rem;
    line-height: 1.1;
    color: var(--color-bronze-text);
    min-width: 2.1rem;
  }

  h3 {
    margin: 0 0 0.2rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .event-card:hover h3 {
    color: var(--color-bronze-text);
  }

  .cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .event-card:hover .arrow {
    transform: translateX(-5px);
  }
</style>
