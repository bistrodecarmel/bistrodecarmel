---
interface Props {
  title: string;
  href: string;
  image: string;
  index: number;
}

const { title, href, image, index } = Astro.props;
const num = String(index).padStart(2, '0');
---

<a class="event-card" href={href}>
  <div class="frame">
    <img src={image} alt={title} loading="lazy" width="480" height="620" />
  </div>
  <div class="event-card-meta">
    <span class="num">{num}</span>
    <h3>{title}</h3>
    <span class="cta">לפרטים נוספים <span class="arrow">←</span></span>
  </div>
</a>

<style>
  .event-card {
    display: block;
    text-decoration: none;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44, 51, 42, 0.35), transparent 45%);
    transition: opacity 0.4s ease;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .event-card:hover .frame img {
    transform: scale(1.06);
  }

  .event-card-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    padding-block-start: 1.1rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-bronze);
    letter-spacing: 0.1em;
  }

  h3 {
    margin: 0;
    font-size: 1.45rem;
  }

  .cta {
    grid-column: 2;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-olive-soft);
    margin-block-start: 0.3rem;
    transition: color 0.2s ease;
  }

  .arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .event-card:hover .cta {
    color: var(--color-bronze);
  }

  .event-card:hover .arrow {
    transform: translateX(-4px);
  }
</style>
