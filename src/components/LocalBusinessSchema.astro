---
/* הקובץ הזה היה היחיד שקידד את הדומיין בקשיחות, בזמן שכל שאר הכתובות
   המוחלטות באתר נגזרות מ-`site` שבקונפיג. התוצאה: כשהאתר רץ על
   netlify.app, הסכימה עדיין הצהירה על הדומיין הישן — כולל תמונה שמחזירה
   404. עכשיו הכל נגזר מאותו מקור אחד. */
const base = Astro.site!;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  '@id': new URL('/#business', base).href,
  name: 'ביסטרו דה כרמל',
  alternateName: 'Bistro de Carmel',
  description:
    'אולם אירועים בוטיק במבנה אבן היסטורי מהמאה ה-19 בזכרון יעקב, לחתונות, בר/בת מצווה, הפקת עליה לתורה, ברית ואירועים עסקיים, עד 250 אורחים.',
  url: new URL('/', base).href,
  telephone: '+972-55-431-6261',
  priceRange: '₪₪₪',
  image: new URL('/og-default.jpg', base).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'רחוב היין 20',
    addressLocality: 'זכרון יעקב',
    addressCountry: 'IL',
  },
  // TODO: town-center approximation for Zichron Yaakov — replace with the venue's exact
  // coordinates (right-click the pin on Google Maps -> copy lat/lng) before launch.
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 32.5714,
    longitude: 34.9506,
  },
  servesCuisine: 'בשרי כשר',
  maximumAttendeeCapacity: 250,
  minimumAttendeeCapacity: 70,
} as const;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
