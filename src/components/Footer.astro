---
import LeadForm from './LeadForm.astro';

const moreLinks = [
  { href: '/בר-מצווה-בצפון/', label: 'בר מצווה בצפון' },
  { href: '/אולם-לחתונה-קטנה/', label: 'אולם לחתונה קטנה' },
  { href: '/bar-bat-mitzva/', label: 'בר ובת מצווה' },
  { href: '/בלוג/', label: 'בלוג — טיפים ומאמרים' },
  { href: '/מדיניות-פרטיות-ביסטרו-דה-כרמל/', label: 'מדיניות פרטיות' },
  { href: '/הצהרת-נגישות-ביסטרו-דה-כרמל/', label: 'הצהרת נגישות' },
];
---

<footer class="site-footer section-dark">
  <img class="footer-corner" src="/images/decor/corner-grapevine.webp" alt="" aria-hidden="true" loading="lazy" />
  <p class="footer-giant" aria-hidden="true">נתראה <i>✦</i> בשמחות</p>
  <div class="container footer-grid">
    <div class="footer-about">
      <h2><strong>ביסטרו</strong> דה כרמל</h2>
      <p>אולם אירועים בסגנון כפרי בזכרון יעקב.<br />מתאים לכל סוגי האירועים עד 250 מוזמנים.</p>
      <a class="phone-big" href="tel:+972554316261">055-4316261</a>

      <nav aria-label="קישורים נוספים">
        <p class="more-links-title">עוד באתר</p>
        <ul>
          {
            moreLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="address">כתובתנו: רחוב היין 20 זכרון יעקב</p>
      <p class="credit">
        <a href="https://www.alma-digital.co.il/" target="_blank" rel="noopener">Alma-Digital בניית אתרים ושיווק דיגיטלי</a>
      </p>
    </div>

    <div class="footer-form">
      <LeadForm heading="השאירו פרטים ונחזור אליכם מיד" instanceId="footer" />
    </div>
  </div>
</footer>

<style>
  .site-footer .footer-giant {
    padding-block-start: 0;
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .site-footer {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-olive-deep) 95%, transparent),
        var(--color-olive-deep)
      ),
      var(--texture-linen-dark) center / cover;
    padding-block: var(--section-pad);
  }

  /* עיטור גפן פינתי — קווי זהב על הרקע הכהה, עדין מאוד */
  .footer-corner {
    position: absolute;
    inset-block-end: -50px;
    inset-inline-start: -50px;
    width: clamp(200px, 24vw, 360px);
    opacity: 0.3;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .footer-corner {
      display: none;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .footer-about h2 {
    font-size: clamp(1.9rem, 2.5vw, 2.6rem);
  }

  .phone-big {
    display: inline-block;
    margin-block: 0.5rem 2rem;
    font-weight: 200;
    font-size: 2rem;
    letter-spacing: 0.03em;
    color: var(--color-bronze-on-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .phone-big:hover {
    color: var(--color-white);
  }

  .more-links-title {
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    color: var(--color-bronze-on-dark);
    margin-block-end: 0.7rem;
  }

  .footer-about ul {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-about ul a {
    color: var(--color-on-dark-soft);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-about ul a:hover {
    color: var(--color-white);
  }

  .address {
    font-size: 0.88rem;
    color: var(--color-on-dark-soft);
  }

  .credit {
    font-size: 0.8rem;
    margin-block-start: 0.25rem;
  }

  .credit a {
    color: color-mix(in srgb, var(--color-on-dark-soft) 75%, transparent);
    text-decoration: none;
  }

  .credit a:hover {
    color: var(--color-on-dark-soft);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
