---
interface Props {
  eyebrow: string;
  /** תומך ב-<strong> להדגשה */
  title: string;
  sub?: string;
  image?: string;
}

const { eyebrow, title, sub, image } = Astro.props;
---

<section class:list={['page-hero', 'section-dark', { 'has-image': !!image }]}>
  {
    image ? (
      <div class="page-hero-grid">
        <div class="page-hero-panel">
          <div class="page-hero-panel-inner">
            <p class="eyebrow no-line" data-animate="fade-up">
              <span class="page-hero-mark" aria-hidden="true" />
              {eyebrow}
            </p>
            <h1 data-animate="fade-up" set:html={title} />
            <span class="page-hero-underline" aria-hidden="true" />
            {sub && <p class="page-hero-sub" data-animate="fade-up" set:html={sub} />}
          </div>
        </div>
        <div class="page-hero-media">
          <div class="page-hero-media-inner">
            <img src={image} alt="" aria-hidden="true" fetchpriority="high" />
          </div>
        </div>
      </div>
    ) : (
      <div class="container page-hero-panel-inner">
        <p class="eyebrow no-line" data-animate="fade-up">
          <span class="page-hero-mark" aria-hidden="true" />
          {eyebrow}
        </p>
        <h1 data-animate="fade-up" set:html={title} />
        <span class="page-hero-underline" aria-hidden="true" />
        {sub && <p class="page-hero-sub" data-animate="fade-up" set:html={sub} />}
      </div>
    )
  }
</section>

<style>
  /* ===== הירו: אותה קומפוזיציה של פיצול עורכי כמו בדף הבית ===== */
  .page-hero {
    position: relative;
    overflow: hidden;
    border-block-end: 1px solid color-mix(in srgb, var(--color-bronze-line) 50%, transparent);

    /* מסילת התוכן — זהה בדיוק ל-.container-wide, כדי שהטקסט יתיישר עם שאר האתר */
    --rail: clamp(1.25rem, 4vw, 2.5rem);
    --panel-basis: calc(var(--container-wide) * 0.42);
  }

  /* וריאציה בלי תמונה (בלוג): טקסטורת פשתן כהה, בלי עמודת מדיה */
  .page-hero:not(.has-image) {
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent),
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent)
      ),
      var(--texture-linen-dark) center / cover;
    padding-block: clamp(4rem, 10vh, 6rem);
  }

  .page-hero-grid {
    display: grid;
    /* RTL: עמודה 1 = ימין = הפאנל, בדיוק כמו בהירו הראשי */
    grid-template-columns:
      max(42%, calc((100% - var(--container-wide)) / 2 + var(--panel-basis)))
      minmax(0, 1fr);
    min-height: clamp(340px, 46svh, 480px);
  }

  .page-hero-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent),
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent)
      ),
      var(--texture-linen-dark) center / cover;
    padding-inline-start: max(var(--rail), calc(100% - var(--panel-basis) + var(--rail)));
    padding-inline-end: clamp(1.5rem, 3vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  /* עמודת התמונה — נקייה, בלי שכבת גרדיאנט מעליה (הטקסט כבר בפאנל) */
  .page-hero-media {
    position: relative;
    overflow: hidden;
  }

  .page-hero-media-inner {
    position: absolute;
    inset: -30px 0;
  }

  .page-hero-media-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero h1 {
    color: var(--color-white);
    font-size: clamp(2rem, 3.2vw + 1rem, 3.4rem);
    max-width: 16ch;
    margin-block-end: 0.3em;
  }

  .page-hero .eyebrow {
    color: var(--color-bronze-on-dark);
    letter-spacing: 0.2em;
  }

  .page-hero-mark {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-bronze-on-dark);
    transform: rotate(45deg);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-bronze-on-dark) 65%, transparent);
  }

  .page-hero-underline {
    display: block;
    width: 4.5rem;
    height: 2px;
    margin-block: 0.25em 1.3em;
    background: linear-gradient(to left, transparent, var(--color-bronze-on-dark) 45%, var(--color-bronze-on-dark));
    transform-origin: right center;
    animation: page-hero-underline-draw 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }

  @keyframes page-hero-underline-draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-underline { animation: none; }
  }

  .page-hero-sub {
    font-size: var(--fs-lead);
    font-weight: 300;
    color: var(--color-on-dark);
    max-width: 480px;
    margin: 0;
  }

  @media (max-width: 900px) {
    .page-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    /* סדר המקור (פאנל→תמונה) נכון ל-RTL בדסקטופ, אבל בערימה רוצים את
       התמונה למעלה. לא order — הוא מנתק סדר ויזואלי מסדר DOM עבור
       משתמשי מקלדת. ראו את אותה הערה בהירו הראשי (index.astro). */
    .page-hero-media {
      grid-row: 1;
      height: clamp(200px, 38svh, 340px);
    }

    .page-hero-media-inner {
      inset: -30px 0;
    }

    .page-hero-panel {
      padding-inline: var(--rail);
      padding-block: clamp(2rem, 6vw, 3rem);
    }
  }
</style>
