---
interface Props {
  eyebrow: string;
  /** תומך ב-<strong> להדגשה */
  title: string;
  sub?: string;
  image?: string;
}

const { eyebrow, title, sub, image } = Astro.props;
---

<section class:list={['page-hero', 'section-dark', { 'has-image': !!image }]}>
  {
    image && (
      <div class="page-hero-bg">
        <img src={image} alt="" aria-hidden="true" fetchpriority="high" />
      </div>
    )
  }
  <div class="page-hero-glow" aria-hidden="true" />
  <div class="page-hero-frame" aria-hidden="true" />
  <div class="container page-hero-content">
    <p class="eyebrow no-line" data-animate="fade-up">
      <span class="page-hero-mark" aria-hidden="true" />
      {eyebrow}
    </p>
    <h1 data-animate="fade-up" set:html={title} />
    <span class="page-hero-underline" aria-hidden="true" />
    {sub && <p class="page-hero-sub" data-animate="fade-up" set:html={sub} />}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(7rem, 16vh, 10rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* וריאציה עם תמונה: אותה שפה חמה כמו ההירו הראשי, מרוסנת יותר */
  .page-hero.has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-ink) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-ink) 66%, #3a2c14) 45%,
      color-mix(in srgb, var(--color-olive-deep) 40%, transparent) 100%
    );
  }

  /* וריאציה בלי תמונה (בלוג): טקסטורת פשתן כהה במקום צבע שטוח אחיד */
  .page-hero:not(.has-image) {
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent),
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent)
      ),
      var(--texture-linen-dark) center / cover;
  }

  /* זוהר ברונזה עדין — עקבי עם ההירו הראשי, אך שקט יותר */
  .page-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      55% 70% at 50% 30%,
      color-mix(in srgb, #e8b96a 22%, transparent) 0%,
      transparent 70%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* מסגרת ברונזה — אותה חתימה עיצובית כמו בדף הבית */
  .page-hero-frame {
    position: absolute;
    inset: 1.1rem;
    z-index: 2;
    border: 1px solid color-mix(in srgb, var(--color-bronze-on-dark) 42%, transparent);
    pointer-events: none;
  }

  .page-hero-content {
    position: relative;
    z-index: 3;
  }

  .page-hero h1 {
    color: var(--color-white);
    font-size: clamp(2.4rem, 4.5vw + 1rem, 4.5rem);
    max-width: 18ch;
    margin-block-end: 0.3em;
  }

  .page-hero .eyebrow {
    color: var(--color-bronze-on-dark);
    letter-spacing: 0.2em;
  }

  .page-hero-mark {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-bronze-on-dark);
    transform: rotate(45deg);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-bronze-on-dark) 65%, transparent);
  }

  .page-hero-underline {
    display: block;
    width: 4.5rem;
    height: 2px;
    margin-block: 0.25em 1.3em;
    background: linear-gradient(to left, transparent, var(--color-bronze-on-dark) 45%, var(--color-bronze-on-dark));
    transform-origin: right center;
    animation: page-hero-underline-draw 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }

  @keyframes page-hero-underline-draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-underline { animation: none; }
  }

  .page-hero-sub {
    font-size: var(--fs-lead);
    font-weight: 300;
    color: var(--color-on-dark);
    max-width: 560px;
    margin: 0;
  }

  @media (max-width: 700px) {
    .page-hero-frame {
      inset: 0.7rem;
    }
  }
</style>
