---
/**
 * דירוג חמישה כוכבים לכרטיס המלצה.
 *
 * שלוש החלטות:
 *
 * 1. SVG ולא התו ★ ולא אימוג'י. הגליף משתנה בין גופנים ובין מערכות הפעלה —
 *    לפעמים דק, לפעמים שמן, ובאנדרואיד לפעמים צבעוני — ואין שליטה על הצורה.
 *    נתיב אחד מצויר נראה זהה בכל מקום ומתחדד בכל רזולוציה.
 *
 * 2. `fill="currentColor"` ולא צבע קשיח. הכרטיסים חיים גם על רקע כהה
 *    (דף הבית, עמודי האירועים) וגם על בהיר (עמוד ההמלצות), ולכל אחד גוון
 *    ברונזה משלו. ההורה קובע `color` והכוכבים מתיישרים לפיו.
 *
 * 3. הכוכבים הם תמונה אחת עם תווית, לא חמישה אלמנטים. קורא מסך שומע
 *    "דירוג חמישה כוכבים מתוך חמישה" פעם אחת במקום חמש הכרזות זהות.
 */
interface Props {
  /** גודל כוכב יחיד ב-px */
  size?: number;
}

const { size = 15 } = Astro.props;

const STAR_PATH =
  'M12 2.1l2.95 5.98 6.6.96-4.77 4.65 1.12 6.57L12 17.16l-5.9 3.1 1.12-6.57L2.45 9.04l6.6-.96z';
---

<span class="stars" role="img" aria-label="דירוג חמישה כוכבים מתוך חמישה">
  {
    Array.from({ length: 5 }).map(() => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d={STAR_PATH} />
      </svg>
    ))
  }
</span>

<style>
  .stars {
    display: flex;
    gap: 0.18em;
    /* הכוכבים יושבים בשורה משלהם מעל הציטוט, ולכן הם צריכים להתחיל
       בקצה הימני של הכרטיס — RTL */
    justify-content: flex-start;
    line-height: 0;
  }
</style>
