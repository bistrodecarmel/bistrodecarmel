---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Img from '../components/Img.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import StarRating from '../components/StarRating.astro';
import { testimonials } from '../data/testimonials';

/* שוברים את הרשימה הארוכה לקבוצות עם מפריד עדין ביניהן, במקום גוש כרטיסים אחיד */
const GROUP_SIZE = 15;
const groups: (typeof testimonials)[number][][] = [];
for (let i = 0; i < testimonials.length; i += GROUP_SIZE) {
  groups.push(testimonials.slice(i, i + GROUP_SIZE));
}
---

<BaseLayout
  title="המלצות - ביסטרו דה כרמל- אירועים קטנים בחיפה I בצפון"
  description="עשרות המלצות אמיתיות של לקוחות שחגגו חתונות, בר/בת מצווה, בריתות ואירועים בביסטרו דה כרמל בזכרון יעקב."
>
  <Header />

  <main>
    <PageHero
      eyebrow="ביסטרו דה כרמל"
      title="<strong>המלצות</strong> מלקוחות אמיתיים"
      sub={`${testimonials.length} משפחות וזוגות שחגגו אצלנו מספרים איך היה — מילה במילה.`}
    />

    <section class="page-section-tight pattern-bg">
      <div class="container-wide">
        <img class="ornament-divider" src="/images/decor/divider-grapes.webp" alt="" aria-hidden="true" loading="lazy" />
        <div class="reviews-grid">
          {
            groups.map((group, gi) => (
              <>
                {gi > 0 && (
                  <div class="reviews-divider" aria-hidden="true">
                    <span />
                    <i>✦</i>
                    <span />
                  </div>
                )}
                {group.map((t) => (
                  <figure class="review-card">
                    <StarRating />
                    <blockquote>{t.quote}</blockquote>
                    <figcaption>
                      <span class="author">{t.author}</span>
                      <span class="date">{t.date}</span>
                    </figcaption>
                  </figure>
                ))}
              </>
            ))
          }
        </div>
      </div>
    </section>

    <div class="watercolor-band on-light" aria-hidden="true">
      <Img
        src="/images/decor/vineyard-watercolor.jpg"
        alt=""
        sizes="100vw"
        widths={[960, 1440, 1920]}
        loading="lazy"
        data-parallax="50"
      />
    </div>

    <CtaBand instanceId="testimonials" />
  </main>

  <Footer />
</BaseLayout>

<style>
  .reviews-grid {
    columns: 3 320px;
    column-gap: 1.25rem;
  }

  /* מפריד בין קבוצות המלצות — שובר את רצף הכרטיסים הארוך על פני כל העמודות */
  .reviews-divider {
    column-span: all;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-block: 0.5rem 1.5rem;
    color: var(--color-bronze-line);
  }

  .reviews-divider span {
    flex: 1;
    height: 1px;
    background: var(--color-ivory-deep);
  }

  .reviews-divider i {
    font-style: normal;
    font-size: 0.85rem;
  }

  .review-card {
    break-inside: avoid;
    margin: 0 0 1.25rem;
    padding: 1.7rem 1.6rem 1.35rem;
    background: var(--color-white);
    border: 1px solid var(--color-ivory-deep);
    border-top: 2px solid var(--color-bronze-line);
    border-radius: var(--radius-md);
  }

  /* גוון הברונזה הכהה — על הרקע הלבן של הכרטיס הגוון הבהיר נעלם.
     `:global` כי `.stars` נולד ב-StarRating ולכן נושא את ה-scope שלו. */
  .review-card :global(.stars) {
    color: var(--color-bronze-text);
    margin-block-end: 0.75rem;
  }

  blockquote {
    margin: 0 0 1.1rem;
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--color-body);
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block-start: 0.8rem;
    border-top: 1px solid var(--color-ivory-deep);
  }

  .author {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .date {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
  }
</style>
