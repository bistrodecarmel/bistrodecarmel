---
import '../styles/global.css';

import StickyCta from '../components/StickyCta.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** כיבוי הפס הקבוע — לעמודים שבהם הוא מיותר או מטריד */
  stickyCta?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  noindex = false,
  stickyCta = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="he-IL" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ביסטרו דה כרמל" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    {stickyCta && <StickyCta />}
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initAnimations } from '../scripts/animations';
      import { initLightbox } from '../scripts/lightbox';
      // reveal.ts קודם: הוא זה שקובע אם [data-animate] יוסתר בכלל
      initReveal();
      initAnimations();
      initLightbox();
    </script>
  </body>
</html>
