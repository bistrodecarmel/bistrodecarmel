---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import EventTypeCard from '../components/EventTypeCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials as allTestimonials } from '../data/testimonials';

/* המלצות בדף הבית: ציטוטים קצרים-בינוניים מתוך ההמלצות האמיתיות */
const homeQuotes = allTestimonials.filter((t) => t.quote.length > 40 && t.quote.length < 260).slice(0, 6);

const eventTypes = [
  { title: 'חתונות', href: '/weddings-bistro-de-carmel/', image: '/images/gallery/venue/venue-06.jpg' },
  { title: 'בר מצווה', href: '/בר-מצווה-בביסטרו-דה-כרמל/', image: '/images/gallery/venue/venue-08.jpg' },
  { title: 'בת מצווה', href: '/בת-מצווה-בביסטרו-דה-כרמל/', image: '/images/gallery/venue/venue-09.jpg' },
  {
    title: 'הפקת עליה לתורה',
    href: '/חוגגים-עלייה-לתורה-ובר-מצווה-בזכרון-יע/',
    image: '/images/gallery/venue/venue-10.jpg',
  },
];

const stats: {
  value: string;
  label: string;
  ltr: boolean;
  count?: string;
  countFormat?: string;
}[] = [
  { value: '70–250', label: 'אורחים באירוע', ltr: true, count: '250', countFormat: '70–{n}' },
  { value: 'המאה ה-19', label: 'מבנה אבן משוחזר', ltr: false },
  { value: 'כשר', label: 'מטבח שף בשרי', ltr: false },
  { value: '50+', label: 'המלצות מלקוחות', ltr: true, count: '50', countFormat: '{n}+' },
];


const galleryImages = [
  { src: '/images/gallery/venue/venue-01.jpg', span: 'tall' },
  { src: '/images/gallery/venue/venue-02.jpg', span: '' },
  { src: '/images/gallery/venue/venue-03.jpg', span: '' },
  { src: '/images/gallery/venue/venue-04.jpg', span: 'wide' },
  { src: '/images/gallery/venue/venue-05.jpg', span: '' },
  { src: '/images/gallery/venue/venue-07.jpeg', span: 'tall' },
  { src: '/images/gallery/venue/venue-11.jpg', span: '' },
  { src: '/images/gallery/venue/venue-12.jpg', span: 'wide' },
  { src: '/images/gallery/venue/venue-06.jpg', span: '' },
  { src: '/images/gallery/venue/venue-08.jpg', span: '' },
];
---

<BaseLayout
  title="ביסטרו דה כרמל - אולם אירועים בזכרון יעקב | אירועים בצפון"
  description="ביסטרו דה כרמל: אירועי בוטיק באווירת יקב אותנטית בזכרון יעקב, במבנה אבן היסטורי מהמאה ה-19. חתונות, בר/בת מצווה, עליה לתורה ואירועים עסקיים עד 250 אורחים."
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    <link rel="preload" as="image" href="/images/atmosphere/hero-sparklers.jpg" />
  </Fragment>

  <Header />

  <main>
    <!-- ===== הירו: פיצול עורכי ===== -->
    <section class="hero">
      <div class="hero-grid">
        <!-- RTL: העמודה הראשונה במקור נוחתת בימין. הפאנל ראשון ⇒ פאנל בימין. -->
        <div class="hero-panel">
          <div class="hero-panel-inner">
            <p class="eyebrow hero-eyebrow no-line" data-animate="fade-up">
              <span class="hero-eyebrow-mark" aria-hidden="true"></span>
              BISTRO DE CARMEL &middot; זכרון יעקב
            </p>
            <h1 class="hero-title">
              <span class="hero-line"><span class="hero-line-inner">אירועי בוטיק</span></span>
              <span class="hero-line"><span class="hero-line-inner"><strong>באווירת יקב אותנטית</strong></span></span>
              <span class="hero-line"><span class="hero-line-inner">בזכרון יעקב</span></span>
            </h1>
            <span class="hero-underline" aria-hidden="true"></span>
            <div class="hero-actions" data-animate="fade-up">
              <a class="btn btn-light" href="#contact" data-magnetic>לפרטים נוספים ותיאום פגישה</a>
              <a class="btn btn-ghost" href="#story" data-magnetic>הסיפור שלנו</a>
            </div>
            <ul class="hero-meta" data-animate="fade-up">
              <li>מבנה אבן מהמאה ה-19</li>
              <li>מטבח שף כשר ובשרי</li>
              <li>70 עד 250 אורחים</li>
            </ul>
          </div>
        </div>

        <div class="hero-media">
          <div class="hero-media-inner" data-parallax="50">
            <img
              src="/images/atmosphere/hero-sparklers.jpg"
              alt="כניסת זוג לאולם ביסטרו דה כרמל בליווי מזרקות זיקוקים, אורחים מריעים משני הצדדים"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ===== הסיפור ===== -->
    <section id="story" class="story">
      <div class="container story-grid">
        <div class="story-text" data-animate="fade-up">
          <p class="eyebrow">01 &middot; הבית שלכם לרגעים הגדולים</p>
          <h2>שילוב קסום בין <strong>היסטוריה קלאסית</strong>, אווירת יקב אותנטית ומטבח שף מוקפד</h2>
          <p class="lead">
            ביסטרו דה כרמל הוא הרבה מעבר למקום אירועים – הוא שילוב קסום בין היסטוריה קלאסית, אווירת יקב
            אותנטית ומטבח שף כשר ובשרי מוקפד.
          </p>
          <p>
            המקום שוכן במבנה אבן משוחזר מהמאה ה-19 בזכרון יעקב, שהוקם על ידי הברון רוטשילד כמשכן
            הייננים, וטומן בחובו את רוח המושבה והכרמים. החלל שלנו משלב אלגנטיות כפרית נצחית עם נגיעות
            עיצוב חמימות, קירות אבן חשופים ותקרות גבוהות שמשקיפות לחצר היקב. בתוך האווירה המיוחדת,
            הטאבון הבוער שלנו מוסיף לניחוחות, ואלמנטים טבעיים ויין יוצרים תחושה של אירוע בוטיק אינטימי
            ויוקרתי.
          </p>
          <p>
            אנו מתמחים ביצירת אירועי בוטיק אישיים ומרגשים, עם גמישות לארח בין 70 ל-250 אורחים. הצוות
            שלנו, מנוסה ומקצועי, מלווה אתכם צעד אחר צעד – החל מבניית תפריט שף בשרי, יוקרתי וכשר מותאם
            אישית, דרך פרטי ההפקה ועד לרגע האירוע עצמו, במקצועיות חמה ובקפדנות בלתי מתפשרת.
          </p>
          <p>
            אם אתם מחפשים לחגוג חתונה קסומה, בר/בת מצווה מרגשת או אירוע חברה באווירה ייחודית, במקום
            שנושם היסטוריה ומשלב חוויה קולינרית איכותית – ביסטרו דה כרמל הוא הבית שלכם. ממוקם בלב זכרון
            יעקב, הוא נגיש ונוח להגעה מכל אזור הצפון והמרכז.
          </p>
          <p>נשמח להעניק לכם ולאורחים שלכם חוויית אירוח מושלמת, מדויקת ומלאת קסם.</p>
        </div>
        <div class="story-media collage" data-animate="fade-up">
          <div class="collage-main arch" data-parallax="26">
            <img
              src="/images/gallery/venue/venue-03.jpg"
              alt="חלל האירועים של ביסטרו דה כרמל — קירות אבן, שולחנות עץ וכיסאות וינטאז'"
              loading="lazy"
            />
          </div>
          <div class="collage-secondary" data-parallax="54">
            <img
              src="/images/gallery/culinary/food-02.jpg"
              alt="מאפים טריים מהטאבון של ביסטרו דה כרמל"
              loading="lazy"
            />
          </div>
          <span class="collage-caption" aria-hidden="true">זכרון יעקב &middot; מאז המאה ה-19</span>
          <div class="story-media-accent" aria-hidden="true"></div>
        </div>
      </div>

      <!-- פס נתונים -->
      <div class="container">
        <dl class="stats pattern-bg" data-animate="stagger">
          {
            stats.map((s) => (
              <div class="stat">
                <dt>{s.label}</dt>
                <dd
                  dir={s.ltr ? 'ltr' : undefined}
                  data-counter={s.count ?? undefined}
                  data-counter-format={s.countFormat ?? undefined}
                >
                  {s.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <MarqueeStrip />

    <!-- ===== חוגגים בביסטרו ===== -->
    <section class="events pattern-bg">
      <div class="container events-body">
        <div class="events-head" data-animate="fade-up">
          <p class="eyebrow">02 &middot; חוגגים בביסטרו</p>
          <h2>אירועים אינטימיים ומרגשים <strong>עד 250 מוזמנים</strong></h2>
          <span class="heading-underline" aria-hidden="true"></span>
          <p class="lead">
            כאן תוכלו לחגוג חתונה קסומה באווירת יקב אותנטית, או להעניק לילדיכם אירוע בר/בת מצווה שכולם
            יזכרו בזכות הפקה שלמה, הכוללת:
          </p>
          <ul class="events-list">
            <li>טקס בבית הכנסת המקומי בליווי חזן מקצועי.</li>
            <li>תהלוכה סוחפת ומרגשת עם נגנים בשופרות ובתופים במדרחוב הציורי והקסום של זכרון יעקב.</li>
            <li>קבלת פנים חגיגית במבנה ההיסטורי, עם תפריט שף משובח.</li>
            <li>צוות הפקה שילווה אתכם אישית בכל שלבי האירוע.</li>
          </ul>
          <p>אנו דואגים לכל פרט ופרט, כדי שאתם תוכלו ליהנות משקט נפשי ומאירוע מושלם.</p>
        </div>

        <div class="event-cards" data-animate="stagger">
          {
            eventTypes.map((e, i) => (
              <div class:list={['event-card-slot', `slot-${i + 1}`]}>
                <EventTypeCard title={e.title} href={e.href} image={e.image} index={i + 1} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== קולינריה ===== -->
    <section id="food" class="food section-dark">
      <div class="food-bg" data-parallax="80">
        <img src="/images/gallery/culinary/food-05.jpg" alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="food-content container">
        <p class="eyebrow" data-animate="fade-up">03 &middot; קולינריה</p>
        <h2 data-animate="fade-up">
          הטאבון הבוער, יינות היקב,<br />
          <strong>וחוויה קולינרית חד פעמית</strong>
        </h2>
        <p class="food-text" data-animate="fade-up">
          ריח הלחם מטאבון האבן בכניסה למקום, מקבל את פני האורחים בניחוחות ממכרים, ויינות היקב וטעמם
          האנין, מייצרים חווית אירוע קולינרית חד פעמית ובלתי נשכחת.
        </p>
        <div class="food-gallery" data-animate="stagger" data-lightbox>
          <img src="/images/gallery/culinary/food-01.jpg" alt="מנת שף מביסטרו דה כרמל" loading="lazy" />
          <img src="/images/gallery/culinary/food-02.jpg" alt="מאפה טרי מהטאבון" loading="lazy" />
          <img src="/images/gallery/culinary/food-03.jpg" alt="קולינריה בביסטרו דה כרמל" loading="lazy" />
          <img src="/images/gallery/culinary/food-04.jpg" alt="תפריט שף בביסטרו דה כרמל" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- חוצץ אקוורל — כרמים בשעת זהב (איור, לא צילום) -->
    <div class="watercolor-band" aria-hidden="true">
      <img src="/images/decor/vineyard-watercolor.jpg" alt="" loading="lazy" data-parallax="50" />
    </div>

    <!-- ===== המלצות ===== -->
    <section class="testimonials section-dark">
      <div class="container-wide">
        <div class="testimonials-head" data-animate="fade-up">
          <p class="eyebrow no-line">04 &middot; לקוחות ממליצים</p>
          <h2>לקוחות ממליצים <strong>על ביסטרו דה כרמל</strong></h2>
        </div>

        <div class="testimonials-grid" data-animate="stagger">
          {homeQuotes.map((t) => (
            <TestimonialCard quote={t.quote} author={t.author} date={t.date} />
          ))}
        </div>

        <div class="testimonials-cta" data-animate="fade-up">
          <a class="btn btn-light" href="/המלצות/">לכל {allTestimonials.length} ההמלצות</a>
        </div>
      </div>
    </section>

    <!-- ===== גלריה ===== -->
    <section id="gallery" class="gallery">
      <div class="container-wide">
        <div class="gallery-head" data-animate="fade-up">
          <p class="eyebrow no-line">05 &middot; גלריית תמונות המקום</p>
          <h2>ביסטרו דה כרמל <strong>בתמונות</strong></h2>
          <img class="ornament-divider" src="/images/decor/divider-grapes.webp" alt="" aria-hidden="true" loading="lazy" />
        </div>
        <div class="gallery-grid" data-lightbox data-animate="stagger">
          {
            galleryImages.map((img, i) => (
              <div class={`gallery-item ${img.span}`}>
                <img src={img.src} alt={`ביסטרו דה כרמל - תמונה ${i + 1}`} loading="lazy" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== צור קשר ===== -->
    <CtaBand instanceId="contact-cta" />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ===== הירו: פיצול עורכי ===== */
  .hero {
    position: relative;
    overflow: hidden;
    border-block-end: 1px solid color-mix(in srgb, var(--color-bronze-line) 50%, transparent);

    /* מסילת התוכן של האתר — זהה בדיוק ל-.container-wide */
    --rail: clamp(1.25rem, 4vw, 2.5rem);
    /* רוחב הפאנל בתוך מסילה של 1440px */
    --panel-basis: calc(var(--container-wide) * 0.42);
  }

  .hero-grid {
    display: grid;
    /* RTL: עמודה 1 = ימין = הפאנל */
    grid-template-columns:
      max(42%, calc((100% - var(--container-wide)) / 2 + var(--panel-basis)))
      minmax(0, 1fr);
    min-height: clamp(520px, 78svh, 840px);
  }

  /* ===== הפאנל הכהה ===== */
  .hero-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-on-dark);
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent),
        color-mix(in srgb, var(--color-olive-deep) 92%, transparent)
      ),
      var(--texture-linen-dark) center / cover;

    /* הקצה הימני של הטקסט נופל בדיוק על מסילת .container-wide.
       padding באחוזים על פריט גריד נפתר מול רוחב אזור הגריד — שנגזר
       מרוחב התוכן של ה-body, בדיוק כמו .container-wide. לכן זה חסין
       פס-גלילה, בניגוד ל-100vw שכולל אותו. */
    padding-inline-start: max(var(--rail), calc(100% - var(--panel-basis) + var(--rail)));
    padding-inline-end: clamp(1.5rem, 3vw, 3.5rem);
    padding-block: clamp(3rem, 8vh, 5.5rem);
  }

  /* ===== עמודת התמונה — נקייה, בלי שום שכבה מעליה ===== */
  .hero-media {
    position: relative;
    overflow: hidden;
  }

  /* מיכל הפרלקס — גולש אנכית כדי שהתזוזה לא תחשוף שוליים */
  .hero-media-inner {
    position: absolute;
    inset: -50px 0;
  }

  .hero-media-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ken Burns — בטוח עכשיו, אין טקסט מעל התמונה */
    animation: kenburns 12s ease-out both;
  }

  @keyframes kenburns {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media-inner img {
      animation: none;
    }
  }

  /* ===== טיפוגרפיה בפאנל =====
     נמדד בדפדפן: השורה הארוכה (באווירת יקב אותנטית, weight 700)
     תופסת 7.94em. רוחב הטקסט הפנימי מתייצב על 508.8px מ-1867px ומעלה,
     ולכן התקרה 3.6rem משאירה ~52px מרווח בכל רוחב גדול. הרצפה 2rem
     מוכתבת מ-320px (280px פנימי מול 254px טקסט). */
  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2rem, 3.9vw, 3.6rem);
    margin-block-end: 0.35em;
  }

  /* חשיפה שורה-שורה — CSS טהור (מבוסס שעון, מסתיים תמיד) */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-block-end: 0.06em; /* מונע חיתוך אותיות יורדות */
  }

  .hero-line-inner {
    display: block;
    transform: translateY(115%);
    animation: hero-line-up 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-line:nth-child(1) .hero-line-inner {
    animation-delay: 0.15s;
  }

  .hero-line:nth-child(2) .hero-line-inner {
    animation-delay: 0.29s;
  }

  .hero-line:nth-child(3) .hero-line-inner {
    animation-delay: 0.43s;
  }

  @keyframes hero-line-up {
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-inner {
      transform: none;
      animation: none;
    }
  }

  .hero-eyebrow {
    color: var(--color-bronze-on-dark);
    letter-spacing: 0.22em;
  }

  /* יהלום זהב קטן — נגיעת יוקרה במקום קו טקסטואלי גנרי */
  .hero-eyebrow-mark {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-bronze-on-dark);
    transform: rotate(45deg);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-bronze-on-dark) 70%, transparent);
  }

  /* קו זהב שנפתח מתחת לכותרת — נחיתה עדינה, לא ישר לתוכן */
  .hero-underline {
    display: block;
    width: 5.5rem;
    height: 2px;
    margin-block: 0.3em 1.8em;
    background: linear-gradient(to left, transparent, var(--color-bronze-on-dark) 45%, var(--color-bronze-on-dark));
    transform-origin: right center;
    animation: underline-draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.75s both;
  }

  @keyframes underline-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-underline {
      animation: none;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-end: 2.25rem;
  }

