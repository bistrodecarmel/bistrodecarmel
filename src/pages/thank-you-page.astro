---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="תודה רבה על פנייתך - ביסטרו דה כרמל"
  description="פנייתכם התקבלה — נחזור אליכם בהקדם."
  noindex
>
  <Header />

  <main>
    <section class="thanks page-section pattern-bg">
      <div class="container thanks-inner">
        <p class="eyebrow no-line" data-animate="fade-up">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          ביסטרו דה כרמל
        </p>
        <h1 data-animate="fade-up"><strong>תודה רבה</strong> על פנייתך!</h1>
        <span class="heading-underline" aria-hidden="true"></span>
        <p class="lead" data-animate="fade-up">קיבלנו את הפרטים ונחזור אליכם בהקדם עם כל המידע על האירוע המושלם שלכם.</p>
        <p class="muted">רוצים לדבר כבר עכשיו? חייגו <a href="tel:+972554316261">055-4316261</a></p>
        <a class="btn btn-primary" href="/">חזרה לדף הבית</a>
        <img
          class="thanks-engraving"
          src="/images/decor/engraving-oil.webp"
          alt=""
          aria-hidden="true"
          loading="lazy"
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .thanks {
    min-height: 55vh;
    display: flex;
    align-items: center;
  }

  .thanks-inner {
    text-align: center;
    max-width: 620px;
  }

  .thanks-inner .eyebrow {
    justify-content: center;
  }

  .thanks-inner .heading-underline {
    margin-inline: auto;
  }

  .thanks-inner p {
    margin-inline: auto;
  }

  .thanks-inner .btn {
    margin-block-start: 1rem;
  }

  .thanks-inner a:not(.btn) {
    color: var(--color-bronze-text);
    font-weight: 700;
  }

  .thanks-engraving {
    margin-inline: auto;
    margin-block-start: 2.5rem;
    width: clamp(120px, 14vw, 170px);
    opacity: 0.85;
  }
</style>
